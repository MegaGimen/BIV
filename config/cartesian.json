{
  "providers": {
    "deepseek": {
      "apiKey": "${DEEPSEEK_API_KEY}",
      "apiBase": "https://api.deepseek.com"
    }
  },
  "modelPresets": {
    "agentA": {
      "label": "Agent A (DeepSeek flash)",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "maxTokens": 8192,
      "contextWindowTokens": 128000,
      "temperature": 0.2
    }
  },
  "agents": {
    "defaults": {
      "modelPreset": "agentA",
      "workspace": "/home/BIV/data/cartesian-nanobot/workspace"
    }
  },
  "tools": {
    "web": {
      "enable": true
    }
  }
}
